# Teqo · tienda. Los valores reales los carga Andrés en Vercel y en Supabase; nunca van al repositorio.

# Supabase (proyecto propio de Teqo, nunca el de Bartez)
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Sitio
VITE_SITE_URL=http://localhost:8080
# Dominio permitido para las funciones de la API (checkout, pagos). En producción, el dominio de la tienda.
API_ALLOWED_ORIGIN=http://localhost:8080

# Mercado Pago (Checkout Pro). El secreto del webhook valida la firma de cada aviso; sin él, ningún pago se acredita.
# El aviso se configura en Mercado Pago apuntando a https://<dominio>/api/pagos?recurso=aviso (evento: pagos).
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
# Base de la API de Mercado Pago (solo cambia en pruebas)
MERCADOPAGO_API_URL=https://api.mercadopago.com
# Cuánto valen las cuotas consultadas antes de volver a preguntar
CUOTAS_CACHE_MINUTOS=30

# Crons de Vercel (recálculo diario de precios). Vercel manda este valor como Bearer.
CRON_SECRET=

# Correo transaccional
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
ADMIN_EMAIL=

# WhatsApp (Meta Business API), opcional
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Mayoristas por API, opcional
AIR_API_TOKEN=
AIR_API_URL=https://api.air-intra.com/v2
AIR_API_USER=
AIR_API_PASS=
ELIT_API_USER_ID=
ELIT_API_TOKEN=

# Buscador de imágenes (api/image-finder.ts)
SERPAPI_API_KEY=
BING_SEARCH_API_KEY=
MERCADOLIBRE_ACCESS_TOKEN=

# Edge Functions de Supabase (se cargan en el panel de Supabase, no acá): ANTHROPIC_API_KEY, GOOGLE_ADS_*
