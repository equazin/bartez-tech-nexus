{
  "cleanUrls": true,
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/image-finder.ts": {
      "maxDuration": 120
    },
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/tecnologia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/productos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/soluciones-corporativas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios-it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partnership",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/empresas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/soluciones-por-industria",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/puntos-de-venta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nosotros",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/evaluacion-tecnologica",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cotizacion",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/create-user",
      "destination": "/api/users"
    },
    {
      "source": "/api/profiles",
      "destination": "/api/users?scope=profile"
    },
    {
      "source": "/api/impersonate",
      "destination": "/api/users?scope=impersonate"
    },
    {
      "source": "/api/quotes",
      "destination": "/api/commerce?resource=quotes"
    },
    {
      "source": "/api/rma",
      "destination": "/api/commerce?resource=rma"
    },
    {
      "source": "/api/coupons",
      "destination": "/api/pricing/coupons"
    },
    {
      "source": "/api/pricing/:path*",
      "destination": "/api/pricing"
    },
    {
      "source": "/api/stock",
      "destination": "/api/products?scope=stock"
    },
    {
      "source": "/api/contact",
      "destination": "/api/email?scope=contact"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/tienda?modulo=checkout"
    },
    {
      "source": "/api/legal",
      "destination": "/api/tienda?modulo=legal"
    },
    {
      "source": "/api/orders",
      "destination": "/api/tienda?modulo=orders"
    },
    {
      "source": "/api/pagos",
      "destination": "/api/tienda?modulo=pagos"
    },
    {
      "source": "/api/precios",
      "destination": "/api/tienda?modulo=precios"
    },
    {
      "source": "/api/air-proxy",
      "destination": "/api/proveedores?proveedor=air"
    },
    {
      "source": "/api/elit-proxy",
      "destination": "/api/proveedores?proveedor=elit"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/"
    }
  ],
  "crons": [
    {
      "path": "/api/tienda?modulo=precios&recurso=recalcular",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/tienda?modulo=pagos&recurso=vencer",
      "schedule": "15 6 * * *"
    }
  ]
}
