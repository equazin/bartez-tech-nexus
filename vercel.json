{
  "cleanUrls": true,
  "trailingSlash": false,
  "images": {
    "sizes": [384, 828],
    "remotePatterns": [
      { "protocol": "https", "hostname": "static.nb.com.ar", "pathname": "^/i/.*$" },
      { "protocol": "https", "hostname": "images.elit.com.ar", "pathname": "^/p/.*$" }
    ],
    "minimumCacheTTL": 2678400,
    "qualities": [75],
    "formats": ["image/webp"]
  },
  "regions": [
    "gru1"
  ],
  "functions": {
    "api/image-finder.ts": {
      "maxDuration": 120
    },
    "api/*.ts": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/tecnologia",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/productos",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/soluciones-corporativas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/servicios-it",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/partnership",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/empresas",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/soluciones-por-industria",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/puntos-de-venta",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/nosotros",
      "destination": "/quienes-somos",
      "permanent": true
    },
    {
      "source": "/contacto",
      "destination": "/ayuda#contacto",
      "permanent": true
    },
    {
      "source": "/evaluacion-tecnologica",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/cotizacion",
      "destination": "/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/robots.txt"
    },
    {
      "source": "/feed-google.xml",
      "destination": "/api/tienda?modulo=feed"
    },
    {
      "source": "/assets/(.*)",
      "destination": "/assets/$1"
    },
    {
      "source": "/api/create-user",
      "destination": "/api/users"
    },
    {
      "source": "/api/profiles",
      "destination": "/api/users?scope=profile"
    },
    {
      "source": "/api/impersonate",
      "destination": "/api/users?scope=impersonate"
    },
    {
      "source": "/api/quotes",
      "destination": "/api/commerce?resource=quotes"
    },
    {
      "source": "/api/rma",
      "destination": "/api/commerce?resource=rma"
    },
    {
      "source": "/api/coupons",
      "destination": "/api/pricing/coupons"
    },
    {
      "source": "/api/pricing/:path*",
      "destination": "/api/pricing"
    },
    {
      "source": "/api/stock",
      "destination": "/api/products?scope=stock"
    },
    {
      "source": "/api/contact",
      "destination": "/api/email?scope=contact"
    },
    {
      "source": "/api/checkout",
      "destination": "/api/tienda?modulo=checkout"
    },
    {
      "source": "/api/legal",
      "destination": "/api/tienda?modulo=legal"
    },
    {
      "source": "/api/orders",
      "destination": "/api/tienda?modulo=orders"
    },
    {
      "source": "/api/pagos",
      "destination": "/api/tienda?modulo=pagos"
    },
    {
      "source": "/api/envios",
      "destination": "/api/tienda?modulo=envios"
    },
    {
      "source": "/api/cuenta",
      "destination": "/api/tienda?modulo=cuenta"
    },
    {
      "source": "/api/precios",
      "destination": "/api/tienda?modulo=precios"
    },
    {
      "source": "/api/air-proxy",
      "destination": "/api/proveedores?proveedor=air"
    },
    {
      "source": "/api/elit-proxy",
      "destination": "/api/proveedores?proveedor=elit"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(buscar|comparar|arma-tu-pc|ofertas|nuevos-ingresos|carrito|cart|checkout|cuenta|seguimiento|arrepentimiento|ayuda|quienes-somos|terminos|privacidad|garantias|login|reset-password|admin|sistema-de-diseno)",
      "destination": "/aplicacion"
    },
    {
      "source": "/compra/:id",
      "destination": "/aplicacion"
    },
    {
      "source": "/clientes/:id",
      "destination": "/aplicacion"
    },
    {
      "source": "/:categoria([a-z0-9][a-z0-9-]*)",
      "destination": "/api/tienda?modulo=pagina&categoria=:categoria"
    },
    {
      "source": "/:categoria([a-z0-9][a-z0-9-]*)/:producto([a-z0-9][a-z0-9-]*)",
      "destination": "/api/tienda?modulo=pagina&categoria=:categoria&producto=:producto"
    }
  ],
  "crons": [
    {
      "path": "/api/tienda?modulo=precios&recurso=recalcular",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/tienda?modulo=pagos&recurso=vencer",
      "schedule": "15 6 * * *"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=manana",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=tarde",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h10",
      "schedule": "0 13 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h11",
      "schedule": "0 14 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h12",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h13",
      "schedule": "0 16 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h14",
      "schedule": "0 17 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h15",
      "schedule": "0 18 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h16",
      "schedule": "0 19 * * 1-5"
    },
    {
      "path": "/api/tienda?modulo=sincronizacion&recurso=correr&turno=h17",
      "schedule": "0 20 * * 1-5"
    }
  ]
}
